{
  "exe": "/opt/strata/build-hip/strata",
  "cwd": "/opt/strata",
  "backend": "hip",
  "hip_ordinal": 0,
  "model_name": "qwen3.8-flash-next-iq3_s",
  "aliases": ["qwen3.8-flash-next", "strata"],
  "tokenizer": "/data/packs/iq3_s/tokenizer",
  "log": "/logs/engine.log",
  "open_browser": false,
  "allowed_hosts": ["LAN_ADDRESS"],
  "fit_max_tokens": true,
  "slot_save_path": "/state/slots",
